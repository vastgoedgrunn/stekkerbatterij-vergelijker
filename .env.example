# ---------------------------------------------------------------------------
# Stekkerbatterij Vergelijker — omgevingsvariabelen
# Kopieer naar `.env.local` en vul in. Commit NOOIT echte secrets.
# Validatie gebeurt in src/lib/env/{client,server}.ts (Zod).
# ---------------------------------------------------------------------------

# Publiek (client-veilig, NEXT_PUBLIC_*)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Plausible: site-specifiek script-ID uit het Plausible-dashboard (aanbevolen).
# Voorbeeld: pa-0ScGRl8JclM68agzcYVvN — analytics + custom events activeren automatisch.
NEXT_PUBLIC_PLAUSIBLE_SCRIPT_ID=""
# Legacy fallback: alleen nodig zonder SCRIPT_ID (oude script.tagged-events integratie).
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=""
# Optioneel: eigen Plausible-host (self-hosted). Leeg = plausible.io cloud.
NEXT_PUBLIC_PLAUSIBLE_HOST=""
NEXT_PUBLIC_SENTRY_DSN=""

# Server-only (secrets — nooit met NEXT_PUBLIC_ prefixen)
DATABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# Payments (release 2) — Mollie
# Leeg = betaalintegratie is een no-op (shop blijft uit). Zet de live/test
# key in Vercel om de shop te activeren. De webhook verifieert de betaalstatus
# door de betaling opnieuw op te vragen bij Mollie (geen aparte secret nodig).
MOLLIE_API_KEY=""

# Shipping (release 2)
SENDCLOUD_API_KEY=""
SENDCLOUD_API_SECRET=""

# Transactionele e-mail (release 2) — Resend
# Leeg = e-mail is een no-op (er wordt niets verstuurd, geen crash).
# EMAIL_FROM moet een geverifieerd afzenderadres zijn, bv.
# "Stekkerbatterij Vergelijker <noreply@jouwdomein.nl>".
RESEND_API_KEY=""
EMAIL_FROM=""

# Observability
SENTRY_AUTH_TOKEN=""

# Zet op "true" om env-validatie over te slaan tijdens builds zonder secrets
SKIP_ENV_VALIDATION="false"
