# ---------------------------------------------------------------------------
# Stekkerbatterij Vergelijker — omgevingsvariabelen
# Kopieer naar `.env.local` en vul in. Commit NOOIT echte secrets.
# Validatie gebeurt in src/lib/env/{client,server}.ts (Zod).
# ---------------------------------------------------------------------------

# Publiek (client-veilig, NEXT_PUBLIC_*)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Plausible: site-specifiek script-ID uit het Plausible-dashboard (aanbevolen).
# Voorbeeld: pa-0ScGRl8JclM68agzcYVvN — analytics + custom events activeren automatisch.
NEXT_PUBLIC_PLAUSIBLE_SCRIPT_ID=""
# Legacy fallback: alleen nodig zonder SCRIPT_ID (oude script.tagged-events integratie).
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=""
# Optioneel: eigen Plausible-host (self-hosted). Leeg = plausible.io cloud.
NEXT_PUBLIC_PLAUSIBLE_HOST=""
NEXT_PUBLIC_SENTRY_DSN=""

# Daisycon publisher media-verificatie (my.daisycon.com → Media → Verifiëren)
# Metatag (aanbevolen): kopieer content uit "Verifieer via metatag".
NEXT_PUBLIC_DAISYCON_VERIFY_CONTENT=""
# Optioneel als Daisycon een andere meta name geeft:
NEXT_PUBLIC_DAISYCON_VERIFY_NAME="daisycon-site-verification"
# Bestand (alternatief): bestandsnaam + inhoud uit "Verifieer via bestand".
DAISYCON_VERIFY_FILENAME=""
DAISYCON_VERIFY_FILE_BODY=""
# Daisycon media-ID (wi in glp8.net links en media_id in feed-URLs), zie
# my.daisycon.com onder Media. Productie (Zendure goedgekeurd): 423133.
DAISYCON_MEDIA_ID=""

# Server-only (secrets — nooit met NEXT_PUBLIC_ prefixen)
DATABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# Payments (release 2) — Mollie
# Leeg = betaalintegratie is een no-op (shop blijft uit). Zet de live/test
# key in Vercel om de shop te activeren. De webhook verifieert de betaalstatus
# door de betaling opnieuw op te vragen bij Mollie (geen aparte secret nodig).
MOLLIE_API_KEY=""

# Shipping (release 2)
SENDCLOUD_API_KEY=""
SENDCLOUD_API_SECRET=""

# Transactionele e-mail (release 2) — Resend
# Leeg = e-mail is een no-op (er wordt niets verstuurd, geen crash).
# EMAIL_FROM moet een geverifieerd afzenderadres zijn, bv.
# "Stekkerbatterij Vergelijker <noreply@jouwdomein.nl>".
RESEND_API_KEY=""
EMAIL_FROM=""

# Observability
SENTRY_AUTH_TOKEN=""
# Plausible Stats API (Business): Settings → API keys → Stats API.
# Nodig voor /admin/analytics (bezoekers, bronnen, pagina's). Bots filtert Plausible al.
PLAUSIBLE_API_KEY=""
# Publieke site-id (domein zoals in Plausible), ook voor admin Stats API:
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN="stekkerbatterijvergelijker.com"

# Bol Partner (affiliate.bol.com)
# Site-ID = `s=` in partner-deeplinks. Zonder deze wrapt /api/go geen bol-commissielinks.
BOL_PUBLISHER_ID=""
# Optioneel: productfeed-URL uit het partner-dashboard (Catalog Discovery).
BOL_PRODUCT_FEED_URL=""
# Optioneel: legacy/API key (feed zonder Bearer werkt ook).
BOL_PARTNER_API_KEY=""

# Zet op "true" om env-validatie over te slaan tijdens builds zonder secrets
SKIP_ENV_VALIDATION="false"
